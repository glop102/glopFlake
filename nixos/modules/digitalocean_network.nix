{
  config,
  lib,
  options,
  pkgs,
  ...
}:
# DigitalOcean does not do DHCP or router advertisements for the public
# interface; cloud-init normally reads the addresses from the metadata service
# and writes them out as static config. This does the same thing for networkd,
# so one system closure works on any droplet with no per-droplet values.
#
#   1. 90-do-bootstrap.network (declared below) gives every NIC an IPv4
#      link-local address, which is enough to reach 169.254.169.254.
#   2. do-network.service fetches /metadata/v1.json, fills in the template,
#      and compares the result with /etc/systemd/network/10-do-public.network.
#      Only when they differ is the file replaced and networkd reloaded.
#
# The rendered file is a plain file in /etc (not one of the /etc/static
# symlinks NixOS manages), so it survives reboots: later boots come up on the
# last-known addresses straight away, even if the metadata service is slow.
let
  renderedName = "10-do-public.network";

  # Placeholders use the same @NAME@ style as pkgs.replaceVars, but the values
  # only exist at runtime. Lines for optional parts (IPv6, the anchor address
  # behind reserved IPs) are dropped when the droplet does not have them.
  template = pkgs.writeText "${renderedName}.in" ''
    # Generated by do-network.service from DigitalOcean metadata.
    # Edits are overwritten whenever the metadata disagrees with this file.
    [Match]
    MACAddress=@MAC@

    [Link]
    RequiredForOnline=routable

    [Network]
    # Keeps 169.254.169.254 reachable on-link even if the addresses below
    # are ever stale, so the service can always fetch fresh values.
    LinkLocalAddressing=ipv4
    IPv6AcceptRA=no
    Address=@IPV4_ADDRESS@/@IPV4_PREFIX@
    Gateway=@IPV4_GATEWAY@
    Address=@IPV6_ADDRESS@/@IPV6_PREFIX@
    Gateway=@IPV6_GATEWAY@
    Address=@ANCHOR_ADDRESS@/@ANCHOR_PREFIX@
    @DNS_LINES@
  '';

  script = pkgs.writeShellApplication {
    name = "do-network";
    runtimeInputs = with pkgs; [
      coreutils
      curl
      diffutils
      gnugrep
      iproute2
      jq
      systemd
    ];
    text = ''
      # Overridable for testing:
      #   DO_NETWORK_DRY_RUN=1 do-network   render and diff, change nothing
      #   DO_METADATA_JSON=file             use a saved v1.json instead of curl
      target=''${DO_NETWORK_TARGET:-/etc/systemd/network/${renderedName}}
      staging=''${DO_NETWORK_STAGING:-/run/do-network/${renderedName}}
      dry_run=''${DO_NETWORK_DRY_RUN:-0}

      json=""
      if [[ -n "''${DO_METADATA_JSON:-}" ]]; then
        json=$(<"$DO_METADATA_JSON")
      else
        # The bootstrap link-local address takes a few seconds to pass
        # duplicate address detection on first boot, so retry for a while.
        for _ in $(seq 60); do
          if json=$(curl -fsS --max-time 3 http://169.254.169.254/metadata/v1.json); then
            break
          fi
          json=""
          sleep 1
        done
      fi
      if [[ -z "$json" ]]; then
        echo "metadata service unreachable; keeping existing network config" >&2
        exit 1
      fi

      field() { jq -r "$1 // empty" <<<"$json"; }
      prefix_of() {
        # dotted netmask -> prefix length
        local bits=0 octet
        IFS=. read -ra octets <<<"$1"
        for octet in "''${octets[@]}"; do
          while ((octet > 0)); do
            bits=$((bits + (octet & 1)))
            octet=$((octet >> 1))
          done
        done
        echo "$bits"
      }

      pub='.interfaces.public[0]'
      mac=$(field "$pub.mac")
      ipv4=$(field "$pub.ipv4.ip_address")
      ipv4_mask=$(field "$pub.ipv4.netmask")
      ipv4_gw=$(field "$pub.ipv4.gateway")
      ipv6=$(field "$pub.ipv6.ip_address")
      ipv6_prefix=$(field "$pub.ipv6.cidr")
      ipv6_gw=$(field "$pub.ipv6.gateway")
      anchor=$(field "$pub.anchor_ipv4.ip_address")
      anchor_mask=$(field "$pub.anchor_ipv4.netmask")
      dns_lines=$(jq -r '.dns.nameservers[]? | "DNS=" + .' <<<"$json")

      if [[ -z "$mac" || -z "$ipv4" || -z "$ipv4_mask" || -z "$ipv4_gw" ]]; then
        echo "metadata is missing the public IPv4 settings; keeping existing config" >&2
        exit 1
      fi

      rendered=$(<${template})
      if [[ -z "$ipv6" || -z "$ipv6_prefix" || -z "$ipv6_gw" ]]; then
        rendered=$(grep -v '@IPV6_' <<<"$rendered")
      fi
      if [[ -z "$anchor" || -z "$anchor_mask" ]]; then
        rendered=$(grep -v '@ANCHOR_' <<<"$rendered")
      fi

      rendered=''${rendered//@MAC@/$mac}
      rendered=''${rendered//@IPV4_ADDRESS@/$ipv4}
      rendered=''${rendered//@IPV4_PREFIX@/$(prefix_of "$ipv4_mask")}
      rendered=''${rendered//@IPV4_GATEWAY@/$ipv4_gw}
      rendered=''${rendered//@IPV6_ADDRESS@/$ipv6}
      rendered=''${rendered//@IPV6_PREFIX@/$ipv6_prefix}
      rendered=''${rendered//@IPV6_GATEWAY@/$ipv6_gw}
      rendered=''${rendered//@ANCHOR_ADDRESS@/$anchor}
      rendered=''${rendered//@ANCHOR_PREFIX@/$(prefix_of "$anchor_mask")}
      rendered=''${rendered//@DNS_LINES@/$dns_lines}

      if grep -qE '@[A-Z0-9_]+@' <<<"$rendered"; then
        echo "unfilled placeholder in rendered config; refusing to install it:" >&2
        grep -nE '@[A-Z0-9_]+@' <<<"$rendered" >&2
        exit 1
      fi

      mkdir -p "$(dirname "$staging")"
      printf '%s\n' "$rendered" >"$staging"

      if cmp -s "$staging" "$target"; then
        echo "network config unchanged"
        changed=0
      else
        if [[ -e "$target" ]]; then
          echo "network config changed:"
          diff -u "$target" "$staging" || true
        else
          echo "no existing $target; rendered:"
          cat "$staging"
        fi
        changed=1
      fi

      if [[ "$dry_run" == 1 ]]; then
        echo "dry run: not installing or reloading"
        exit 0
      fi

      iface=$(ip -o link | grep -i "link/ether $mac" | cut -d: -f2 | tr -d ' ' | cut -d@ -f1)
      if [[ -z "$iface" ]]; then
        echo "no interface has MAC $mac" >&2
        exit 1
      fi

      if ((changed)); then
        install -m 0644 "$staging" "$target"
        networkctl reload
        networkctl reconfigure "$iface"
      fi

      systemd-networkd-wait-online --interface="$iface:routable" --timeout=60
    '';
  };
in
{
  options.glopFlake.digitalOceanNetwork.enable = lib.mkEnableOption "configuring the public NIC of a DigitalOcean droplet from its metadata service";

  config = lib.mkIf config.glopFlake.digitalOceanNetwork.enable (
    lib.mkMerge [
      {
        networking = {
          useDHCP = false;
          useNetworkd = true;
        };
        services.resolved.enable = true;

        # Catch-all for any NIC without a better match: link-local only. Sorted
        # after 10-do-public.network, so the public NIC uses the rendered file
        # once it exists, and the private VPC NIC just sits here unused.
        systemd.network.networks."90-do-bootstrap" = {
          matchConfig.Type = "ether";
          networkConfig = {
            LinkLocalAddressing = "ipv4";
            IPv6AcceptRA = false;
          };
          linkConfig.RequiredForOnline = "no";
        };

        systemd.services.do-network = {
          description = "Configure the public interface from DigitalOcean metadata";
          wantedBy = [
            "multi-user.target"
            "network-online.target"
          ];
          before = [ "network-online.target" ];
          after = [ "systemd-networkd.service" ];
          requires = [ "systemd-networkd.service" ];
          # Not restarted by nixos-rebuild switch; the addresses only change if the
          # droplet's metadata does, and the next boot will pick that up.
          restartIfChanged = false;
          serviceConfig = {
            Type = "oneshot";
            RemainAfterExit = true;
            ExecStart = lib.getExe script;
          };
        };
        environment.systemPackages = [ script ];
      }

      # The DO module's own metadata fetch (SSH keys, entropy seed) only retries
      # for 10 seconds; start it once the network is actually configured. Only
      # when that module is imported, or this would define a unit with no
      # ExecStart (the kexec installer image does not import it).
      (lib.optionalAttrs (options.virtualisation ? digitalOcean) {
        systemd.services.digitalocean-metadata = {
          after = [ "do-network.service" ];
          wants = [ "do-network.service" ];
        };
      })
    ]
  );
}
